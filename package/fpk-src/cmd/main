#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/photopea.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
PORT="${TRIM_SERVICE_PORT:-8887}"
WEBROOT="${TRIM_APPDEST}/www.photopea.com"

PYTHON="/var/apps/python312/target/bin/python3.12"
if [ ! -x "${PYTHON}" ]; then
	PYTHON=$(command -v python3 2>/dev/null || echo "python3")
fi

CMD="${PYTHON} -m http.server ${PORT} --bind 0.0.0.0 --directory ${WEBROOT}"

log_msg() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null
}

check_process() {
	local pid=$1
	kill -0 "${pid}" 2>/dev/null
}

start_process() {
	if status; then
		return 0
	fi

	if [ ! -d "${WEBROOT}" ]; then
		log_msg "missing webroot: ${WEBROOT}"
		return 1
	fi

	mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
	log_msg "Starting Photopea on port ${PORT}..."
	bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
	printf "%s" "$!" > "${PID_FILE}"
	sleep 1
	if status; then
		return 0
	fi
	log_msg "Failed to start Photopea"
	return 1
}

stop_process() {
	log_msg "Stopping Photopea..."
	if [ -r "${PID_FILE}" ]; then
		pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
		if check_process "${pid}"; then
			kill -TERM "${pid}" 2>/dev/null
			count=0
			while check_process "${pid}" && [ "${count}" -lt 10 ]; do
				sleep 1
				count=$((count + 1))
			done
			if check_process "${pid}"; then
				kill -KILL "${pid}" 2>/dev/null
			fi
		fi
		rm -f "${PID_FILE}"
	fi
	return 0
}

status() {
	if [ -f "${PID_FILE}" ]; then
		pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
		if check_process "${pid}"; then
			return 0
		fi
		rm -f "${PID_FILE}"
	fi
	return 1
}

case "$1" in
start)
	start_process
	;;
stop)
	stop_process
	;;
status)
	if status; then
		exit 0
	fi
	exit 3
	;;
*)
	exit 1
	;;
esac
