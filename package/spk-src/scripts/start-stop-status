#!/bin/sh
# Photopea DSM 套件启停脚本

PKG="${SYNOPKG_PKGNAME:-photopea}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/photopea/var}"
DEST="${SYNOPKG_PKGDEST:-/var/packages/photopea/target}"
PID_FILE="${VAR}/photopea.pid"
LOG_FILE="${VAR}/photopea.log"
PORT="8887"
WEBROOT="${DEST}/www.photopea.com"

log_msg() {
	_m="$1"
	echo "$_m" >&2
	if [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
		printf '%s\n' "$_m" >> "${SYNOPKG_TEMP_LOGFILE}"
	fi
	mkdir -p "${VAR}" 2>/dev/null || true
	printf '%s: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$_m" >> "${LOG_FILE}" 2>/dev/null || true
}

find_python() {
	for p in \
		/var/packages/Python3.9/target/bin/python3 \
		/var/packages/Python3/target/bin/python3 \
		/usr/local/bin/python3 \
		/usr/bin/python3
	do
		if [ -x "$p" ]; then
			echo "$p"
			return 0
		fi
	done
	command -v python3 2>/dev/null
}

is_running() {
	[ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null
}

start_server() {
	PYTHON="$(find_python)"
	if [ -z "${PYTHON}" ]; then
		log_msg "未找到 python3，请安装群晖 Python 套件。"
		return 1
	fi
	if [ ! -d "${WEBROOT}" ]; then
		log_msg "静态资源目录不存在: ${WEBROOT}"
		return 1
	fi

	mkdir -p "${VAR}" 2>/dev/null || true
	cd "${WEBROOT}" || return 1

	if "${PYTHON}" -m http.server --help 2>&1 | grep -q -- '--bind'; then
		nohup "${PYTHON}" -m http.server "${PORT}" --bind 0.0.0.0 >> "${LOG_FILE}" 2>&1 &
	else
		nohup "${PYTHON}" -m http.server "${PORT}" >> "${LOG_FILE}" 2>&1 &
	fi

	echo $! > "${PID_FILE}"
	sleep 1
	if is_running; then
		return 0
	fi
	log_msg "Photopea 启动失败，请查看 ${LOG_FILE}"
	return 1
}

stop_server() {
	if [ -f "${PID_FILE}" ]; then
		pid="$(cat "${PID_FILE}")"
		kill "${pid}" 2>/dev/null || true
		i=0
		while [ "$i" -lt 10 ]; do
			kill -0 "${pid}" 2>/dev/null || break
			sleep 1
			i=$((i + 1))
		done
		kill -9 "${pid}" 2>/dev/null || true
		rm -f "${PID_FILE}"
	fi
	pkill -f "http.server ${PORT}" 2>/dev/null || true
	return 0
}

case "$1" in
start)
	if is_running; then
		exit 0
	fi
	start_server
	exit $?
	;;
stop)
	stop_server
	exit 0
	;;
status)
	if is_running; then
		exit 0
	fi
	exit 3
	;;
*)
	echo "Usage: $0 {start|stop|status}" >&2
	exit 1
	;;
esac
